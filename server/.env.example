PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge
# Atlas example (include the database name after .net/):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/foodbridge?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:8888

# Used only when no Admin user exists yet
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
